diff --git a/lib/api-fetch.ts b/lib/api-fetch.ts
new file mode 100644
index 0000000..b6d56bf
--- /dev/null
+++ b/lib/api-fetch.ts
@@ -0,0 +1,32 @@
+"use client";
+
+import { loadByokKey } from "./storage";
+
+type Endpoint = "diagnose" | "questions" | "output";
+
+export interface CallApiArgs<TBody> {
+  endpoint: Endpoint;
+  body: TBody;
+}
+
+export async function callApi<TBody, TResp>({
+  endpoint,
+  body,
+}: CallApiArgs<TBody>): Promise<TResp> {
+  const key = loadByokKey();
+  const url = key ? `/api/byok/${endpoint}` : `/api/demo/${endpoint}`;
+  const headers: Record<string, string> = {
+    "Content-Type": "application/json",
+  };
+  if (key) headers["X-API-Key"] = key;
+  const res = await fetch(url, {
+    method: "POST",
+    headers,
+    body: JSON.stringify(body),
+  });
+  const data = (await res.json()) as TResp & { error?: string };
+  if (!res.ok) {
+    throw new Error(data.error ?? `Request to /${endpoint} failed.`);
+  }
+  return data;
+}
diff --git a/lib/byok-helpers.ts b/lib/byok-helpers.ts
new file mode 100644
index 0000000..aec24c9
--- /dev/null
+++ b/lib/byok-helpers.ts
@@ -0,0 +1,9 @@
+const KEY_PREFIX = /^sk-ant-/;
+
+export function extractBYOKKey(req: Request): string | null {
+  const header = req.headers.get("x-api-key");
+  if (!header) return null;
+  const trimmed = header.trim();
+  if (!KEY_PREFIX.test(trimmed)) return null;
+  return trimmed;
+}
